{{ if eq .osid "darwin" -}}
#!/bin/bash

brew bundle --file=/dev/stdin <<EOF
{{ range .packages.darwin.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .packages.darwin.casks -}}
cask {{ . | quote }}
{{ end -}}
EOF

{{ else if eq .osid "linux-linuxmint" -}}
#!/bin/bash
sudo apt-get update && sudo apt-get install -y {{ range .packages.linuxmint.packages }} {{ . }} {{ end }}

# install mise
sudo apt install -y extrepo
sudo extrepo enable mise
sudo apt update
sudo apt install -y mise

# install fzf via mise
mise use -g fzf@latest

